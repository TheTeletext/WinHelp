#include "winhelp_res.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/* TELETEXT PORT (phase 2a, gap 3): the WinHelp 3.1 menu bar, item for
 * item as WINHELP.EXE 3.10 shows it in the WfW 3.11 VM (real_menu_*.png):
 * File Edit Bookmark Help, no Options menu (History is a button there; the
 * font sizes stay on the right-click menu; Always on Top is under Help).
 * F1 still runs How to Use Help (MAIN_ACCEL) but, as in 3.1, the menu does
 * not show it. */
MAIN_MENU MENU
{
 POPUP "&File" {
  MENUITEM "&Open...", MNID_FILE_OPEN
  MENUITEM SEPARATOR
  MENUITEM "&Print Topic", MNID_FILE_PRINT
  MENUITEM "P&rint Setup...", MNID_FILE_SETUP
   MENUITEM SEPARATOR
  MENUITEM "E&xit", MNID_FILE_EXIT
 }
 POPUP "&Edit" {
   MENUITEM "&Copy...", MNID_EDIT_COPYDLG
   MENUITEM SEPARATOR
   MENUITEM "&Annotate...", MNID_EDIT_ANNOTATE
 }
 POPUP "Book&mark" {
   MENUITEM "&Define...", MNID_BKMK_DEFINE
 }
 POPUP "&Help" {
   MENUITEM "&How to Use Help", MNID_HELP_HELPON
   MENUITEM "Always on &Top", MNID_HELP_HELPTOP
   MENUITEM SEPARATOR
   MENUITEM "&About Help...", MNID_HELP_ABOUT
 }
}

CONTEXT_MENU MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "Annotation...",       MNID_CTXT_ANNOTATE
		MENUITEM "Copy",                MNID_CTXT_COPY
		MENUITEM "Print...",            MNID_CTXT_PRINT
		POPUP    "Fonts"
		BEGIN
			MENUITEM "Small",       MNID_CTXT_FONTS_SMALL
			MENUITEM "Normal",      MNID_CTXT_FONTS_NORMAL
			MENUITEM "Large",       MNID_CTXT_FONTS_LARGE
		END
	END
END

STRINGTABLE
{
STID_WINE_HELP, 	"The Teletext WinHelp"  /* TELETEXT PORT: product name (was "Wine Help") */
STID_WHERROR, 		"ERROR"
STID_WARNING,  		"WARNING"
STID_INFO,  		"Information"
STID_NOT_IMPLEMENTED, 	"Not yet implemented"
STID_HLPFILE_ERROR_s, 	"Error while reading the help file `%s'"
STID_INDEX, 		"&Search"      /* TELETEXT PORT: WinHelp 3.1 labels (were "&Index", "Summary") */
STID_CONTENTS,		"&Contents"
STID_TT_HISTORY,	"His&tory"     /* TELETEXT PORT: the 3.1 History button */
STID_BACK, 		"&Back"
STID_ALL_FILES, 	"All files (*.*)"
STID_HELP_FILES_HLP, 	"Help files (*.hlp)"
STID_FILE_NOT_FOUND_s	"Cannot find '%s'. Do you want to find this file yourself?"
STID_NO_RICHEDIT	"Cannot find a richedit implementation... Aborting"
STID_PSH_INDEX,		"Help topics: "
STID_TT_CLOSE,		"Close"     /* TELETEXT PORT: Search's Cancel after Show Topics */
}

/* TELETEXT PORT (phase 2a): the WinHelp 3.1 Search dialog, as WINHELP.EXE
 * 3.10 shows it. ttsearch.c places every control in pixels in
 * WM_INITDIALOG (measured from the real dialog), so the DLUs here are only
 * nominal. */
IDD_TT_SEARCH DIALOG 0, 0, 260, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search"
FONT 8, "MS Sans Serif"
{
    LTEXT         "Type a &word, or select one from the list.\nThen choose Show Topics.", IDC_TTS_PROMPT1, 4, 6, 180, 18
    EDITTEXT      IDC_TTS_EDIT, 4, 28, 172, 12, ES_AUTOHSCROLL
    LISTBOX       IDC_TTS_KEYS, 16, 40, 238, 50, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | LBS_DISABLENOSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON    "Cancel", IDCANCEL, 190, 6, 62, 14
    PUSHBUTTON    "&Show Topics", IDC_TTS_SHOW, 190, 24, 62, 14
    CONTROL       "", IDC_TTS_RULE, "Static", SS_OWNERDRAW, 4, 96, 250, 1
    LTEXT         "Select a &topic, then choose Go To.", IDC_TTS_PROMPT2, 4, 106, 180, 9
    PUSHBUTTON    "&Go To", IDC_TTS_GOTO, 190, 102, 62, 14
    LISTBOX       IDC_TTS_TOPICS, 4, 120, 250, 60, LBS_NOTIFY | LBS_SORT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
}

/* TELETEXT PORT (phase 2a, gap 3): "About Help", in the layout of WinHelp
 * 3.1's own About box (real_about.png: icon left, lines of text, rules,
 * OK top right) instead of Windows' ShellAbout. It carries the credits the
 * LGPL asks for (phase 1 report s8, item 4): the Wine project, the licence
 * and where the source is. ttabout.c makes the font bold and the box
 * white, as Windows 3.1 drew dialogs. */
IDD_TT_ABOUT DIALOG 0, 0, 262, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Help"
FONT 8, "MS Sans Serif"
{
    ICON          IDI_WINHELP, IDC_TTA_ICON, 10, 12, 21, 20
    LTEXT         "The Teletext WinHelp", -1, 52, 10, 140, 9
    LTEXT         "Version 0.2 (phase 2a, 2026-11-13)", -1, 52, 20, 150, 9
    LTEXT         "Copyright \251 2026 The Teletext", -1, 52, 30, 150, 9
    LTEXT         "Reads Windows 3.0 and 3.1 help files", -1, 52, 40, 160, 9
    DEFPUSHBUTTON "OK", IDOK, 200, 8, 52, 15
    CONTROL       "", IDC_TTA_RULE1, "Static", SS_OWNERDRAW, 52, 54, 200, 1
    LTEXT         "Based on Wine's WinHelp viewer (winhlp32),\nCopyright \251 1996-2010 Ulrich Schmid, Eric Pouech,\nSylvain Petreolle, Ken Belleau, Kirill K. Smirnov\nand the other Wine project authors.", -1, 52, 60, 205, 38
    LTEXT         "Free software under the GNU Lesser General Public\nLicense, version 2.1 or later. NO WARRANTY.\nSource: https://github.com/TheTeletext/WinHelp", -1, 52, 102, 205, 28
    CONTROL       "", IDC_TTA_RULE2, "Static", SS_OWNERDRAW, 52, 134, 200, 1
    LTEXT         "Windows 3.1 look: Copyright \251 2026 Dimitri\nPapadopoulos (from Teletext Navigator), LGPL.", -1, 52, 140, 205, 20
}

IDD_INDEX DIALOG 0, 0, 200, 190
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Index"
{
    LISTBOX IDC_INDEXLIST, 10, 10, 180, 150, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER
}

IDD_SEARCH DIALOG 0, 0, 200, 190
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Search"
{
    LTEXT  "Not yet implemented", -1, 10, 10, 180, 150
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL


MAIN_ACCEL ACCELERATORS
{
    VK_F1, MNID_HELP_HELPON, VIRTKEY
}

/* @makedep: winhelp.ico */
IDI_WINHELP ICON winhelp.ico
